mapa_2022
limites_pobreza <- range(
c(
mapa_pobreza$pobreza_2016,
mapa_pobreza$pobreza_2018,
mapa_pobreza$pobreza_2020,
mapa_pobreza$pobreza_2022
),
na.rm = TRUE
