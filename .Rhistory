extraer_pobreza <- function(hoja) {
tabla <- read_excel(
"Anexo estad”stico entidades 2022.xlsx",
sheet = hoja,
col_names = FALSE
)
fila_pobreza <- which(tabla[[3]] == "Población en situación de pobreza")[1]
data.frame(
ENTIDAD = hoja,
